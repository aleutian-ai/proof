      "required": [
        "dir"
      ],
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "files_checked": {
          "type": "integer"
        },
        "intact": {
          "type": "boolean"
        },
        "not_proven": {
          "type": "string"
        },
        "problems": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "detail": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "detail"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "proven": {
          "type": "string"
        }
      },
      "required": [
        "intact",
        "files_checked",
        "proven",
        "not_proven"
      ],
      "type": "object"
    }
  },
  {
    "name": "verify_chain",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
