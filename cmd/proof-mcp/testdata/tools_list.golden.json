          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "breaks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "break_type": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "entry_id": {
                "type": "string"
              },
              "position": {
                "type": "integer"
              }
            },
            "required": [
              "position",
              "entry_id",
              "break_type"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "entries_verified": {
          "type": "integer"
        },
        "erased_found": {
          "type": "integer"
        },
        "first_break": {
          "type": "integer"
        },
        "last_tombstone": {
          "type": "integer"
        },
        "not_proven": {
          "type": "string"
        },
        "proven": {
          "type": "string"
        },
        "tombstones_found": {
          "type": "integer"
        },
        "verdict": {
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "entries_verified",
        "tombstones_found",
        "last_tombstone",
        "erased_found",
        "first_break",
        "proven",
        "not_proven"
      ],
      "type": "object"
    }
  },
  {
    "name": "verify_inclusion",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "leaf_content_hash": {
          "description": "the leaf's content hash, 128 hex characters",
          "maxLength": 128,
          "type": "string"
        },
        "leaf_index": {
          "description": "zero-based position of the leaf in the tree",
          "minimum": 0,
          "type": "integer"
        },
        "proof_hex": {
          "description": "the audit path, each element hex-encoded",
          "items": {
            "maxLength": 128,
            "type": "string"
          },
          "maxItems": 63,
          "type": [
            "null",
            "array"
          ]
        },
        "root_hex": {
          "description": "the expected Merkle root, hex-encoded",
          "maxLength": 128,
          "type": "string"
        },
        "tree_size": {
          "description": "total number of leaves",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "leaf_content_hash",
        "leaf_index",
        "tree_size",
        "proof_hex",
        "root_hex"
      ],
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "included": {
          "type": "boolean"
        }
      },
      "required": [
        "included",
        "detail"
      ],
      "type": "object"
    }
  }
]
