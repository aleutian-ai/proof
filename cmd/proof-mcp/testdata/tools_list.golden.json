            },
            "pii_action": {
              "type": "string"
            },
            "pii_categories": {
              "type": "string"
            },
            "pii_detected": {
              "type": "boolean"
            },
            "pii_digest_key_version": {
              "type": "string"
            },
            "processing_mode": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "signing_key_id": {
              "type": "string"
            },
            "source_type": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "timestamp_ms": {
              "type": "integer"
            },
            "trust_level": {
              "type": "string"
            },
            "user_id": {
              "type": "string"
            }
          },
          "required": [
